<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12 and later draw a splash screen of their own as the app starts: the page background and the
        launcher icon. No splash library is needed.
    -->
    <style name="Theme.Kvizic" parent="Base.Theme.Kvizic">
        <item name="android:windowSplashScreenBackground">@color/kvizic_page_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
